# Koneksi Database PostgreSQL (Lokal / Neon / Supabase / Railway)
DATABASE_URL="postgresql://postgres:password@localhost:5432/cloud_print_db?schema=public"

# Kunci Rahasia Token JWT (Gunakan string acak minimal 32 karakter saat publish)
JWT_SECRET="ganti-dengan-secret-key-panjang-dan-aman-minimal-32-karakter"

# Konfigurasi Akun Admin Awal (Dijalankan melalui: npm run db:seed)
ADMIN_NAME="Administrator Cloud Print"
ADMIN_EMAIL="admin@cloudprint.id"
ADMIN_PASSWORD="AdminCloudPrint2026!"

# Nama Aplikasi
NEXT_PUBLIC_APP_NAME="Cloud Print"
